[0.000, "o", "               \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+337 ## Test Harness\u001b[39m                                                                              \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+338 \u001b[39m                                                                                             \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+339 A CLI test tool is available at `test/compaction-strategies.ts` to compare strategies:\u001b[39m       \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+340 \u001b[39m                                                                                             \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+341 ```bash\u001b[39m                                                                                      \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+342 npx tsx test/compaction-strategies.ts before-compaction\u001b[39m                                      \u001b[49m\r\r\n\u001b[48;2;40;50;40m \u001b[38;2;181;189;104m+343 npx tsx test/compaction-strategies.ts large-session\u001b[39m                      "]
