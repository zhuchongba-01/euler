{
	"name": "@zhongchongba/euler-client",
	"version": "0.1.1",
	"description": "Transport-neutral client for remote Euler sessions over framed CBOR bytes.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./unix": {
			"types": "./dist/unix.d.ts",
			"import": "./dist/unix.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"euler",
		"client",
		"protocol",
		"cbor",
		"binary"
	],
	"author": "Euler contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zhuchongba-01/euler.git",
		"directory": "packages/client"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@zhongchongba/euler-protocol": "^0.1.1"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"homepage": "https://github.com/zhuchongba-01/euler#readme",
	"bugs": {
		"url": "https://github.com/zhuchongba-01/euler/issues"
	}
}
