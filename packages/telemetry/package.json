{
	"name": "@zhongchongba/euler-telemetry",
	"version": "0.1.1",
	"description": "Vendor-neutral telemetry contracts for Euler.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"euler",
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "Euler contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zhuchongba-01/euler.git",
		"directory": "packages/telemetry"
	},
	"homepage": "https://github.com/zhuchongba-01/euler#readme",
	"bugs": {
		"url": "https://github.com/zhuchongba-01/euler/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	}
}
