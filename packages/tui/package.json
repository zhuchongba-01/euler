{
	"name": "@zhongchongba/euler-tui",
	"version": "0.1.1",
	"description": "Terminal UI library used by Euler.",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.c",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"README.md"
	],
	"keywords": [
		"euler",
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Euler contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zhuchongba-01/euler.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2"
	},
	"homepage": "https://github.com/zhuchongba-01/euler#readme",
	"bugs": {
		"url": "https://github.com/zhuchongba-01/euler/issues"
	}
}
