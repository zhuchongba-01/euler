{
	"name": "@zhongchongba/euler-session-backend-sqlite-node",
	"version": "0.1.0",
	"description": "Node SQLite session backend for Euler agent sessions.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && node ./scripts/prepare-dist.mjs copy-sqlite-migrations",
		"test": "vitest --run",
		"coverage": "vitest --run --coverage",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "Euler contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zhuchongba-01/euler.git",
		"directory": "packages/session-backends/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@zhongchongba/euler-ai": "^0.1.0",
		"@zhongchongba/euler-agent-core": "^0.1.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.9",
		"vitest": "4.1.9"
	},
	"homepage": "https://github.com/zhuchongba-01/euler#readme",
	"bugs": {
		"url": "https://github.com/zhuchongba-01/euler/issues"
	},
	"keywords": [
		"euler"
	]
}
